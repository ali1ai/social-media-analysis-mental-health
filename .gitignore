# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.DS_Store

# Data is never committed (licence + sensitive content)
data/*
!data/.gitkeep

# Trained models are large; regenerate with `make train`
models/*
!models/.gitkeep

# Generated reports: keep the model card, metrics and figures once you've run on real data
reports/*
!reports/.gitkeep
!reports/MODEL_CARD.md
!reports/metrics.json
!reports/figures/
reports/figures/*
!reports/figures/*.png

# Local stand-in models used for offline testing
notebooks/distilroberta-base/

# Package copy unpacked by the notebook's setup cell when run outside the repo
_smm_embedded/
